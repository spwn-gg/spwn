{
  "name": "spwn",
  "version": "0.1.1",
  "description": "CLI + web server for managing Claude Code sessions",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "server": "cargo run --manifest-path backend/Cargo.toml -- serve --no-open",
    "build": "vite build",
    "build:all": "npm run build",
    "build:app": "npm run build:all && cargo build --release --manifest-path backend/Cargo.toml",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.1.6",
    "marked": "^14.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "esbuild": "^0.24.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
